	double cdr_seaice_conc_monthly_stdev(time, y, x) ;
		cdr_seaice_conc_monthly_stdev:_FillValue = -1. ;
		cdr_seaice_conc_monthly_stdev:long_name = "NOAA/NSIDC CDR of Passive Microwave Monthly Northern Hemisphere Sea Ice Concentration Source Estimated Standard Deviation" ;
